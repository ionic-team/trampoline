{
    "compilerOptions": {
      "allowUnreachableCode": false,
      "declaration": true,
      "esModuleInterop": true,
      "importHelpers": false,
      "module": "node16",
      "moduleResolution": "node16",
      "noFallthroughCasesInSwitch": true,
      "noUnusedLocals": false,
      "outDir": "./dist",
      "rootDir": "./src",
      "pretty": true,
      "strict": true,
      "target": "es2022",
      "lib": ["dom", "es2022"]
    },
    "include": ["src/*.ts","src/**/*.ts"],
  }
